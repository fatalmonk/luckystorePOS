{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckystore1947.com/schemas/source-inventory-v1.json",
  "title": "Lucky Store source inventory metadata",
  "type": "object",
  "required": ["schema_version", "generated_by", "read_only", "remote_sources", "missing_scopes", "summary", "sources"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_by": { "type": "string" },
    "read_only": { "const": true },
    "remote_sources": {
      "type": "object",
      "required": ["r2_listing"],
      "properties": {
        "r2_listing": { "type": "string" },
        "bucket_binding": { "type": "string" },
        "bucket_name": { "type": "string" },
        "total_bucket_objects": { "type": "integer", "minimum": 0 },
        "total_bucket_bytes": { "type": "integer", "minimum": 0 },
        "product_object_count": { "type": "integer", "minimum": 0 },
        "classified_prefix_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "sha256_available": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "missing_scopes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "summary": {
      "type": "object",
      "required": ["source_count", "counts_by_status", "counts_by_kind"],
      "properties": {
        "source_count": { "type": "integer", "minimum": 0 },
        "counts_by_status": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "counts_by_kind": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_path", "source_kind", "owner_authority", "format", "item_key", "object_key_or_url", "size_bytes", "sha256", "current_callers", "status", "migration_notes"],
        "properties": {
          "source_path": { "type": "string", "minLength": 1 },
          "source_row": { "type": "integer", "minimum": 1 },
          "source_kind": { "type": "string", "minLength": 1 },
          "owner_authority": { "type": "string", "minLength": 1 },
          "format": { "type": "string" },
          "item_key": { "type": ["string", "null"] },
          "item_key_kind": { "enum": ["item_id", "sku", "barcode", null] },
          "object_key_or_url": { "type": ["string", "null"] },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "etag": { "type": ["string", "null"] },
          "content_type": { "type": ["string", "null"] },
          "last_modified": { "type": ["string", "null"], "format": "date-time" },
          "current_callers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "match_status": { "enum": ["matched", "ambiguous", "unresolved"] },
          "status": { "enum": ["canonical", "adapter", "legacy", "unresolved"] },
          "migration_notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
