# Supabase Test Environment Variables
# These tests are authorized only for the disposable Lucky Store Security Tests
# project. Do not use local or production credentials.

SUPABASE_TEST_PROJECT_REF=replace-with-disposable-test-project-ref
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
DATABASE_URL=postgresql://postgres:your-database-password-here@db.example.invalid:54322/postgres
