# -----------------------------------------------------------------------------
# Lucky Store POS - Root .gitignore
# Cleaned for monorepo: Flutter + Node + Supabase + Scripts
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Environment / Secrets
# -----------------------------------------------------------------------------
.env
.env.*
.env.local
.env.*.local
.env.secrets
!.env.example
!.env.secrets.example

apps/*/.env
apps/*/.env.*
# But allow .env.example template files (they contain only placeholders, no real secrets)
!apps/*/.env.example
apps/mobile_app/env/*
!apps/mobile_app/env/.env.example
# Cloudflare wrangler dev vars (secrets)
**/.dev.vars

# Secret files
*.key
*.pem
*.p12
*.pfx
*.crt
*.csr
*client_secret*.json

# -----------------------------------------------------------------------------
# Node / JS / Package Managers
# -----------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
*.traineddata
*-DRAFT.pdf
aiREADME.md
audit_reports/
scripts/seo/*_discrepancies.json
scripts/seo/audit_polar_storefront.mjs
scripts/ops/extract-*.mjs
scripts/ops/generate-*-audit-report.mjs
scripts/ops/scan-receipts-dryrun.mjs
scripts/ops/triage-*.mjs

.npm/
.pnpm-store/

.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# -----------------------------------------------------------------------------
# Build Outputs / Coverage / Cache
# -----------------------------------------------------------------------------
dist/
build/
out/
coverage/
.nyc_output/

.cache/
.parcel-cache/
.turbo/
.next/
.expo/
.nuxt/
.svelte-kit/

*.tsbuildinfo
/storefront-release.zip

# -----------------------------------------------------------------------------
# Flutter / Dart
# -----------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub/
pubspec.lock
build/

# -----------------------------------------------------------------------------
# Supabase / Local DB State
# -----------------------------------------------------------------------------
.supabase/
supabase/.temp/
supabase/.branches/
supabase/.cache/
deno.lock

# Dumps / backups only
dumps/
backups/
*.dump
*.sql.gz
*.sql.zip
*.bak.sql
*.sql.bak
supabasebakcup/
*.backup

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
logs/
*.log
*.pid
*.pid.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# Editors / IDE
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json

.idea/
*.iml
*.suo
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# OS Junk
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db

# -----------------------------------------------------------------------------
# Hosting Platforms
# -----------------------------------------------------------------------------
.vercel/

# Wrangler local dev state / cache
.wrangler/

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/


# -----------------------------------------------------------------------------
# Temporary / Scratch
# -----------------------------------------------------------------------------
tmp/
temp/
*.tmp
*.bak
*.orig
.~*
*~
/blink


# -----------------------------------------------------------------------------
# Local AI Tool Metadata
# -----------------------------------------------------------------------------
.cursor/
.agents/
.agents_archive/
.impeccable/
.claude/
.continue/
.trae/
skills-lock.json

# Databricks AI Dev Kit (project-local generated state)
.ai-dev-kit/
.databricks/
.gemini/
.github/skills/
GEMINI.md

# -----------------------------------------------------------------------------
# Data Exports (scoped, not global)
# -----------------------------------------------------------------------------
data/exports/
data/tmp/
apps/scraper/output/

# Scraper data files (keep code, ignore data)
apps/scraper/*_products.json
apps/scraper/scraped_images/
*.xlsx
*.xls
*.csv
!data/samples/*.csv

# -----------------------------------------------------------------------------
# Archive / Legacy Local Storage
# -----------------------------------------------------------------------------
archive/

# -----------------------------------------------------------------------------
# IDE Inspection Artifacts (IntelliJ / Android Studio)
# -----------------------------------------------------------------------------
# These large XML files are auto-generated and should not be versioned.
SpellCheckingInspection.xml
AndroidDomInspection.xml
*.inspectionProfile.xml
.inspections/

# -----------------------------------------------------------------------------
# Scratch / One-off SQL files
# -----------------------------------------------------------------------------
scratch_*.sql
apply_*_v2.sql

# -----------------------------------------------------------------------------
# Flutter asset env (safe to bundle, but keep out of git history)
# -----------------------------------------------------------------------------
# app.env is safe-to-bundle (anon key only) but still shouldn't be committed
# to avoid leaking even non-secret config. Manage via CI secrets.
apps/mobile_app/assets/app.env

# Ignore generated Flutter analysis folder
apps/mobile_app/flutter/
# Ignore local JSON secrets
data/*.json
.vercel/


# Aion session artifacts
.aionrs/
.env
.env.local

# Vercel custom public output directory
dist_public/

# Documentation migration starts with the root index and reviewed collections.
# Keep the inherited corpus ignored until each collection is reviewed and admitted.
/docs/*
!/docs/README.md
!/docs/adr/
!/docs/adr/**
!/docs/audits/
/docs/audits/*
!/docs/audits/competitor-prices-final-review.md

# Neon sync artifacts (contain data, not just schema)
_plans/neon_data.sql

# Local image catalog backup folder
catalog-images/
.env*
!.env.example
!.env.secrets.example
!apps/*/.env.example
!apps/mobile_app/env/.env.example
!supabase/tests/.env.test.example

