# Keep in sync with security-headers.cjs. LiteSpeed serves static files
# without passing them through Next.js header rules.
<IfModule mod_headers.c>
  Header always unset X-Frame-Options
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always unset Referrer-Policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always unset X-Content-Type-Options
  Header always set X-Content-Type-Options "nosniff"
  Header always unset Strict-Transport-Security
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always unset Content-Security-Policy-Report-Only
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://maps.googleapis.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://images.luckystore1947.com https://www.google-analytics.com https://www.googletagmanager.com https://www.facebook.com https://*.facebook.com https://maps.gstatic.com https://maps.googleapis.com https://*.google.com https://*.gstatic.com; connect-src 'self' https://*.supabase.co https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://connect.facebook.net https://www.facebook.com https://*.facebook.com https://maps.googleapis.com https://images.luckystore1947.com https://agent.luckystore1947.com https://notfair.co https://cloudflareinsights.com https://*.cloudflare.com; frame-src 'self' https://www.google.com https://maps.google.com https://www.googletagmanager.com https://www.facebook.com"
  Header always unset Permissions-Policy
  Header always set Permissions-Policy "camera=(), microphone=(), payment=(), usb=(), interest-cohort=(), browsing-topics=(), geolocation=(self)"
  SetEnvIf Request_URI "^/scripts/" lucky_versioned_script
  Header always set Cache-Control "public, max-age=31536000, immutable" env=lucky_versioned_script
  <FilesMatch "\.(?:webp|avif|png|jpe?g|gif|svg|ico|woff2)$">
    Header always set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.webmanifest$">
    Header always set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
AddType application/manifest+json .webmanifest
