{
  "name": "customer_storefront",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/apply-next-dev-manifest-memory-patch.mjs && cross-env NEXT_DEV_DIST_DIR=.next-turbo next dev --turbo",
    "dev:webpack": "node scripts/apply-next-dev-manifest-memory-patch.mjs && cross-env NEXT_DEV_DIST_DIR=.next-webpack next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "cross-env ANALYZE=true next build",
    "verify:skills": "node scripts/verify-agent-skills.mjs"
  },
  "dependencies": {
    "@animate-ui/react": "^2.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.45.0",
    "@vercel/analytics": "^1.4.1",
    "@vercel/speed-insights": "^2.0.0",
    "autoprefixer": "^10.4.20",
    "cn": "^0.5.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "motion": "^14.6.0",
    "notfair-nextjs-blog": "https://github.com/nowork-studio/notfair-nextjs-blog/releases/download/v0.4.1/notfair-nextjs-blog-0.4.1.tgz",
    "postcss": "^8.5.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.18.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.4.7",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.5",
    "@next/eslint-plugin-next": "16.4.5",
    "@playwright/test": "^1.45.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18",
    "@types/sanitize-html": "^2.16.2",
    "cross-env": "^7.0.3",
    "eslint": "^10.2.1",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.0.0",
    "next": "16.4.5",
    "typescript": "^5.9.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "browserslist": [
    "chrome >= 120",
    "edge >= 120",
    "firefox >= 120",
    "safari >= 17.4",
    "ios_saf >= 17.4"
  ],
  "optionalDependencies": {
    "@next/swc-darwin-arm64": "^15.5.19"
  },
  "overrides": {
    "next": "15.5.28",
    "postcss": "^8.5.29",
    "postcss-selector-parser": "^7.1.6"
  }
}
