# ============================================================
# Lucky Store — Customer Mobile App Environment Variables
# ============================================================
# ⚠️  EXPO_PUBLIC_ prefix = bundled into client app binary.
#     ONLY anon/publishable keys and public endpoints belong here.
#     NEVER put service-role keys, database passwords, or secret tokens here.
#
# HOW TO USE:
#   cp .env.example .env.local
#   # Configure .env.local for local testing; never commit .env.local
#
# ── HTTPS Backend API URL ────────────────────────────────────
# Development: http://localhost:3000 (Next.js storefront dev server) or LAN IP for physical devices
# Production: https://www.luckystore1947.com
EXPO_PUBLIC_API_URL="https://www.luckystore1947.com"

# ── Supabase (Client-Safe / Anon Access) ─────────────────────
# Mobile apps must NEVER connect directly to Postgres port 5432 or 6543 poolers.
# In accordance with Supabase Postgres Best Practices:
# 1. Direct connections consume finite client slots and lack mobile connection resilience.
# 2. Client queries must route via PostgREST HTTPS endpoints with Row Level Security (RLS)
#    or via the versioned mobile API gateway (/api/mobile/v1/*).
# 3. Use ONLY the public anon key. RLS must enforce tenant and user isolation.
EXPO_PUBLIC_SUPABASE_URL="https://hvmyxyccfnkrbxqbhlnm.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_your_anon_key_here"

# ── Store & Tenant Binding ──────────────────────────────────
# Default store ID for Lucky Store Chawkbazar
EXPO_PUBLIC_STORE_ID="4acf0fb2-f831-4205-b9f8-e1e8b4e6e8fd"

# ── Image CDN (Cloudflare R2 Public Bucket) ──────────────────
EXPO_PUBLIC_IMAGE_BASE_URL="https://images.luckystore1947.com"
