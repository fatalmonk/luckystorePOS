# ============================================================
# Lucky Store — Root Environment Variables
# ============================================================
# SERVER-SIDE ONLY: Never expose these to browsers or clients.
# Copy to .env.local and fill in real values.
#
# All values below are placeholders. Never commit secrets.

# Supabase
SUPABASE_PROJECT_REF=<placeholder>
SUPABASE_URL=<placeholder>
SUPABASE_SERVICE_ROLE_KEY=<placeholder>
SUPABASE_JWT_SECRET=<placeholder>
SUPABASE_ACCESS_TOKEN=<placeholder>
SUPABASE_DISCOVERY_URL=<placeholder>

# Supabase public client configuration
VITE_SUPABASE_URL=<placeholder>
VITE_SUPABASE_ANON_KEY=<placeholder>

# Database: local development and migrations only
DATABASE_URL=<placeholder>
DIRECT_DATABASE_URL=<placeholder>
SUPABASE_DB_PASSWORD=<placeholder>

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=<placeholder>
CLOUDFLARE_API_TOKEN=<placeholder>

# Cloudflare Images / R2
R2_ACCOUNT_ID=<placeholder>
R2_ACCESS_KEY_ID=<placeholder>
R2_SECRET_ACCESS_KEY=<placeholder>
R2_BUCKET_NAME=<placeholder>
R2_PUBLIC_URL=<placeholder>

# Payment: server-side only
SSLCOMMERZ_STORE_ID=<placeholder>
SSLCOMMERZ_STORE_PASSWORD=<placeholder>
SSLCOMMERZ_IS_LIVE=false

# WhatsApp Business Cloud API: server-side only
WHATSAPP_PHONE_NUMBER_ID=<placeholder>
WHATSAPP_ACCESS_TOKEN=<placeholder>
WHATSAPP_VERIFY_TOKEN=<placeholder>
META_APP_SECRET=<placeholder>
WHATSAPP_FALLBACK_NUMBER=<placeholder>
