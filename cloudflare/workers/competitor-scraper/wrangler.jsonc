{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lucky-store-competitor-scraper",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "browser": {
    "binding": "BROWSER"
  },
  "workflows": [
    {
      "name": "lucky-store-competitor-scrape",
      "binding": "COMPETITOR_SCRAPE_WORKFLOW",
      "class_name": "CompetitorScrapeWorkflow"
    }
  ],
  "triggers": {
    "crons": ["0 21 * * SUN"]
  },
  "vars": {
    "AUTOMATION_ENABLED": "true",
    "WORKFLOW_VERSION": "competitor-scrape-v1",
    "STORE_ALLOWLIST": "[\"4acf0fb2-f831-4205-b9f8-e1e8b4e6e8fd\"]",
    "SUPABASE_URL": "https://hvmyxyccfnkrbxqbhlnm.supabase.co",
    "CHALDAL_SOURCE_APPROVED": "true",
    "SHWAPNO_SOURCE_APPROVED": "true",
    "KHULSHI_MART_SOURCE_APPROVED": "true",
    "THE_BASKET_SOURCE_APPROVED": "true",
    "PAI_MART_SOURCE_APPROVED": "true"
  }
}
