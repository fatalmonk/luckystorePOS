{
  "datasets": [
    {
      "name": "ds_expenses",
      "displayName": "Procurement Expenses",
      "queryLines": [
        "SELECT expense_date, vendor, item_description, amount_bdt, payment_type, expense_category, audit_status\n",
        "FROM procurement_expenses"
      ],
      "columns": [
        {
          "displayName": "Total Outflow",
          "description": "Total expense amount in BDT",
          "expression": "SUM(`amount_bdt`)"
        },
        {
          "displayName": "Stock Spend",
          "description": "Spend dedicated to stock purchase in BDT",
          "expression": "SUM(CASE WHEN `expense_category` = 'Stock Purchase' THEN `amount_bdt` ELSE 0 END)"
        },
        {
          "displayName": "Transaction Count",
          "description": "Total number of expense transactions",
          "expression": "COUNT(1)"
        }
      ]
    },
    {
      "name": "ds_inventory",
      "displayName": "Retail Inventory Catalog",
      "queryLines": [
        "SELECT sku, name, brand, cost_bdt, price_bdt, mrp_bdt, unit_margin_bdt, margin_percentage\n",
        "FROM retail_inventory"
      ],
      "columns": [
        {
          "displayName": "Catalog SKUs",
          "description": "Count of distinct active SKUs",
          "expression": "COUNT(`sku`)"
        },
        {
          "displayName": "Average Margin %",
          "description": "Mean retail margin across catalog (0-1)",
          "expression": "AVG(`margin_percentage`) / 100.0"
        }
      ]
    },
    {
      "name": "ds_monthly_spend",
      "displayName": "Monthly Outflow by Category",
      "queryLines": [
        "SELECT DATE_TRUNC('MONTH', expense_date) AS month_date, expense_category, ROUND(SUM(amount_bdt), 2) AS monthly_spend\n",
        "FROM procurement_expenses\n",
        "GROUP BY 1, 2\n",
        "ORDER BY 1 ASC"
      ]
    },
    {
      "name": "ds_payment_channels",
      "displayName": "Payment Channel Outflows",
      "queryLines": [
        "SELECT payment_type, ROUND(SUM(amount_bdt), 2) AS total_spend, COUNT(1) AS txn_count\n",
        "FROM procurement_expenses\n",
        "GROUP BY payment_type"
      ]
    },
    {
      "name": "ds_top_vendors",
      "displayName": "Top Suppliers & Vendors",
      "queryLines": [
        "SELECT vendor, payment_type, ROUND(SUM(amount_bdt), 2) AS total_spend, COUNT(1) AS txn_count\n",
        "FROM procurement_expenses\n",
        "GROUP BY 1, 2\n",
        "ORDER BY total_spend DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "ds_brand_margins",
      "displayName": "Brand Margin Performance",
      "queryLines": [
        "SELECT brand, COUNT(sku) AS sku_count, ROUND(AVG(margin_percentage), 1) AS avg_margin_pct, ROUND(AVG(unit_margin_bdt), 2) AS avg_unit_margin_bdt\n",
        "FROM retail_inventory\n",
        "GROUP BY brand\n",
        "HAVING COUNT(sku) >= 3\n",
        "ORDER BY sku_count DESC\n",
        "LIMIT 10"
      ]
    }
  ],
